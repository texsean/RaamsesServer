<Window x:Class="Raamses.RGS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAAMSES Gateway Server (RGS) - Windows" Height="800" Width="1400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />   <!-- Left: Config + Logfiles -->
            <ColumnDefinition Width="2*" />  <!-- Right: Icons + Raw + Log Tail -->
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Server Configuration" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <!-- Config options go here (verification mode, etc.) -->
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Verification Mode:" Width="140" VerticalAlignment="Center"/>
                <ComboBox x:Name="VerificationModeCombo" Width="120" SelectedIndex="0">
                    <ComboBoxItem Content="Blink"/>
                    <ComboBoxItem Content="FileBased"/>
                    <ComboBoxItem Content="LocalLLM"/>
                </ComboBox>
            </StackPanel>

            <Button Content="Apply Changes" Width="120" Margin="0,10" Click="ApplyConfig_Click"/>

            <!-- Logfile list -->
            <TextBlock Text="Log Files" FontSize="14" FontWeight="Bold" Margin="0,20,0,5"/>
            <ListBox x:Name="LogFileList" Height="200"/>
        </StackPanel>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Icons -->
                <RowDefinition Height="*"/>    <!-- Raw comms -->
                <RowDefinition Height="2*"/>   <!-- Log tail -->
            </Grid.RowDefinitions>

            <!-- Connected Displays Icons (XAML) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Connected Displays:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <!-- Icons will be added programmatically or as XAML Path elements -->
                <StackPanel x:Name="DisplayIconsPanel" Orientation="Horizontal"/>
            </StackPanel>

            <!-- Raw Communication -->
            <GroupBox Grid.Row="1" Header="Raw Communication (Displays ↔ Agents)">
                <TextBox x:Name="RawCommsBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <!-- Log Tail -->
            <GroupBox Grid.Row="2" Header="Current Log Tail (mmddyy-hhmmss.nnn)">
                <TextBox x:Name="LogTailBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>