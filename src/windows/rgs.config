# RGS Server Configuration
# Format: key=value
# Lines starting with # or ; are comments

# Gateway listener port
port=8765

# Heartbeat timeout (seconds)
heartbeat=30

# Maximum connected agents
max_agents=50

# Log level: debug, info, warn, error
log_level=info

# Log file path
log_file=rgs_server.log

# Schema version
schema_version=1.0
